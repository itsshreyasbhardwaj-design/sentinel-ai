# ---------------------------------------------------------------------------
# Sentinel AI configuration
#
# Every value here has a working default. Sentinel runs with this file absent
# entirely: SQLite, an in-memory cache, an in-process job queue and the offline
# knowledge-base analyst are selected automatically.
#
# Check what is actually active at any time with GET /api/health.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000

# --- Storage ---------------------------------------------------------------
# Omit DATABASE_URL to use the bundled SQLite storage (requires Node 22.5+).
# DATABASE_URL=postgresql://user:password@host:5432/sentinel
SQLITE_PATH=.sentinel/sentinel.db

# --- Cache -----------------------------------------------------------------
# Omit for an in-memory LRU. Set for multi-instance deployments.
# REDIS_URL=redis://localhost:6379

# --- Authentication --------------------------------------------------------
# REQUIRED in production. Without these, Sentinel refuses to start with
# NODE_ENV=production rather than serving an unauthenticated dashboard.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# --- AI analysis -----------------------------------------------------------
# Without a key, explanations come from the built-in knowledge base: offline,
# deterministic and free. A key makes the prose more specific to your code.
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
AI_PROVIDER=auto
AI_MAX_EXPLANATIONS=50

# --- Background jobs -------------------------------------------------------
# TRIGGER_SECRET_KEY=tr_dev_...

# --- GitHub integration ----------------------------------------------------
# Needed for private repositories and for webhook-triggered scans.
# GITHUB_TOKEN=ghp_...
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_ID=

# --- Security --------------------------------------------------------------
# REQUIRED in production. Encrypts stored integration tokens at rest.
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# Scan creation is limited separately from reads: a scan costs minutes of CPU.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_SCAN_WINDOW_MS=3600000
RATE_LIMIT_SCAN_MAX=10
MAX_UPLOAD_BYTES=104857600

# Master switch for scanner egress (OSV.dev advisory lookups).
# Off by default so a scan never leaves your network without you choosing it.
ALLOW_NETWORK_SCANNERS=false

# --- Scan limits -----------------------------------------------------------
SCAN_MAX_FILES=25000
SCAN_MAX_FILE_BYTES=2097152
SCAN_CONCURRENCY=8
SCAN_TIMEOUT_MS=900000
